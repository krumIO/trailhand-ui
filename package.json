{
  "name": "@krumio/trailhand-ui",
  "version": "1.5.0",
  "type": "module",
  "description": "Reusable web components built with Lit Element",
  "main": "./dist/toggle-switch.js",
  "module": "./dist/toggle-switch.js",
  "types": "./dist/toggle-switch.d.ts",
  "exports": {
    ".": {
      "types": "./dist/toggle-switch.d.ts",
      "default": "./dist/toggle-switch.js"
    },
    "./toggle-switch": {
      "types": "./dist/toggle-switch.d.ts",
      "default": "./dist/toggle-switch.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "default": "./dist/data-table.js"
    },
    "./action-menu": {
      "types": "./dist/action-menu.d.ts",
      "default": "./dist/action-menu.js"
    },
    "./button": {
      "types": "./dist/Button.d.ts",
      "default": "./dist/Button.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook",
    "prepublishOnly": "npm run build",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krumIO/trailhand-ui.git"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "toggle",
    "switch",
    "ui-components"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@iconify/icons-heroicons": "^1.2.9",
    "iconify-icon": "^3.0.2",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-vitest": "^10.2.0",
    "@storybook/web-components-vite": "^10.2.0",
    "@types/node": "^25.0.3",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "chromatic": "^15.0.0",
    "playwright": "^1.57.0",
    "storybook": "^10.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.17"
  }
}
