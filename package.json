{
  "name": "@krumio/trailhand-ui",
  "version": "1.4.1",
  "type": "module",
  "description": "Reusable web components built with Lit Element",
  "main": "./dist/toggle-switch.js",
  "module": "./dist/toggle-switch.js",
  "types": "./dist/toggle-switch.d.ts",
  "exports": {
    ".": {
      "types": "./dist/toggle-switch.d.ts",
      "default": "./dist/toggle-switch.js"
    },
    "./toggle-switch": {
      "types": "./dist/toggle-switch.d.ts",
      "default": "./dist/toggle-switch.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "default": "./dist/data-table.js"
    },
    "./action-menu": {
      "types": "./dist/action-menu.d.ts",
      "default": "./dist/action-menu.js"
    },
    "./button": {
      "types": "./dist/Button.d.ts",
      "default": "./dist/Button.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krumIO/trailhand-ui.git"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "toggle",
    "switch",
    "ui-components"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@iconify/icons-heroicons": "^1.2.9",
    "iconify-icon": "^3.0.2",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "@types/node": "^25.0.3",
    "storybook": "^8.6.14",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
